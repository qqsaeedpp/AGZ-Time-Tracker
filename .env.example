# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace-with-your-token

# Comma-separated numeric telegram ids of bot owners
OWNER_IDS=8593698934,8192967759

# MySQL async DSN (utf8mb4 required for Persian text and emoji)
DATABASE_URL=mysql+aiomysql://agz:agz@localhost:3306/agz_support?charset=utf8mb4

# Timezone (do not change unless you know what you are doing)
TIMEZONE=Asia/Tehran

# Daily report time (24h, Tehran time)
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=59

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
